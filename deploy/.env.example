# ===== 基础 =====
APP_ENV=dev
MYSQL_URL=mysql+pymysql://kb:kb123456@mysql:3306/kb_platform?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
MILVUS_URI=milvus-standalone:19530
JWT_SECRET=please-change-me
INTERNAL_TOKEN=please-change-me-too

# ===== 模型（AutoDL 双端口：6006=vLLM LLM；6008=bge-m3 + reranker 同进程双接口）=====
# 地址随实例变化，开机后索取并仅改此处
LLM_BASE_URL=http://your-autodl-host:6006/v1
LLM_API_KEY=sk-atguigu
LLM_MODEL=qwen3-8b
LLM_MAX_CONTEXT=8192
LLM_FAIL_SWITCH=2
LLM_FALLBACK_BASE_URL=https://your-fallback/v1
LLM_FALLBACK_API_KEY=sk-yyy
LLM_FALLBACK_MODEL=gpt-5.6-luna

EMBEDDING_BASE_URL=http://your-autodl-host:6008
EMBEDDING_PROTOCOL=autodl_bge
# autodl_bge:  POST {base}/embeddings  body={"embedding_documents":[".."]}
#              resp={"dense":[[float]],"sparse":[..]}   sparse v1 忽略；dim=1024
EMBEDDING_MODEL=bge-m3

RERANK_URL=http://your-autodl-host:6008/v1/rerank
RERANK_HEALTH_URL=http://your-autodl-host:6008/health
RERANK_PROTOCOL=custom
# custom:      POST /v1/rerank {"query":"..","documents":[..]} -> {"scores":[..]}（顺序保持，已归一化）

# ===== 检索与生成参数（SDD §7）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DENSE_TOP_K=50
KEYWORD_TOP_K=20
KEYWORD_TIMEOUT_MS=200
RRF_K=60
RERANK_TOP_N=6
FAQ_EXACT_SIM=0.92
GAP_SIM=0.35
MINE_MIN_FREQ=3
EMBED_DIM=1024
PERM_SNAPSHOT_TTL=300
